{
    "name": "mdb-reader",
    "version": "4.0.0",
    "description": "JavaScript library to read data from Access databases",
    "main": "lib/node.js",
    "browser": "lib/browser.js",
    "types": "lib/node.d.ts",
    "exports": {
        ".": {
            "types": "./lib/node.d.ts",
            "node": "./lib/node.js",
            "default": "./lib/browser.js"
        },
        "./node": {
            "types": "./lib/node.d.ts",
            "default": "./lib/node.js"
        },
        "./browser": {
            "types": "./lib/browser.d.ts",
            "default": "./lib/browser.js"
        },
        "./package.json": "./package.json"
    },
    "sideEffects": false,
    "type": "module",
    "files": [
        "lib"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/andipaetzold/mdb-reader.git"
    },
    "keywords": [
        "mdb",
        "microsoft",
        "access",
        "database"
    ],
    "author": {
        "name": "Andi Pätzold",
        "email": "github@andipaetzold.com",
        "url": "https://github.com/andipaetzold"
    },
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/andipaetzold/mdb-reader/issues"
    },
    "homepage": "https://github.com/andipaetzold/mdb-reader#readme",
    "dependencies": {
        "browserify-aes": "^1.0.0",
        "create-hash": "^1.0.0",
        "fast-xml-parser": "^4.0.0 || ^5.0.0",
        "pako": "^2.0.0 || ^3.0.0"
    },
    "devDependencies": {
        "@tsconfig/node22": "22.0.7",
        "@tsconfig/strictest": "2.0.5",
        "@types/node": "22.20.5",
        "@types/pako": "2.0.4",
        "oxlint": "1.94.0",
        "rimraf": "6.0.1",
        "typescript": "7.0.2",
        "vite": "6.4.5",
        "vitest": "4.1.11"
    },
    "scripts": {
        "prepublishOnly": "npm run build",
        "prebuild": "rimraf lib",
        "build": "tsc -P tsconfig.json",
        "test": "npm run typecheck && npm run test:unit && npm run test:esm",
        "test:unit": "vitest run",
        "test:esm": "node --input-type=module -e \"import './lib/node.js'; import './lib/browser.js';\"",
        "lint": "oxlint",
        "typecheck": "tsc -P tsconfig.test.json"
    },
    "overrides": {
        "vite": "$vite"
    }
}
