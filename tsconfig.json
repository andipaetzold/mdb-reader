{
    "extends": ["@tsconfig/node22/tsconfig.json", "@tsconfig/strictest/tsconfig.json"],
    "compilerOptions": {
        "rootDir": "src",
        "types": ["node"],
        "outDir": "lib",
        "module": "Node16",
        "moduleResolution": "node16",
        "declaration": true,
        "verbatimModuleSyntax": true
    },
    "include": ["src/node.ts", "src/browser.ts", "typings/**/*.d.ts"]
}
